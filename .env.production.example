# Production Environment Variables (for Docker host)
# Copy this to .env on your production server before running docker-compose

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=talkitout

# JWT (generate a strong random secret)
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
JWT_EXPIRATION=7d

# Gemini AI (for Mira AI Companion)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Telegram Check-in API Key
TELEGRAM_API_KEY=talkitout-telegram-secret
