# Database
# Development: localhost:5432 (direct) or localhost:3062 (Docker mapped port)
# Production:  db:5432 (Docker internal network, set in docker-compose.yml)
DATABASE_URL="postgresql://postgres:password@localhost:5432/talkitout?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"

# Server
# Development: 3001
# Production:  3061 (set in docker-compose.yml)
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN="*"

# Gemini AI (for Mira AI Companion)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Telegram Check-in API Key
TELEGRAM_API_KEY=talkitout-telegram-secret
